{
  "name": "@epdoc/exif",
  "version": "0.1.52",
  "description": "Read and write EXIF metadata via the exiftool binary, with GPS parsing, date resolution, and reverse geocoding",
  "exports": {
    ".": "./src/mod.ts"
  },
  "publish": {
    "include": [
      "src",
      "deno.json",
      "README.md",
      "library-metadata.json"
    ]
  },
  "$build": {
    "bin": {
      "exif": "./main.ts"
    }
  },
  "compile": {
    "include": [
      "./src",
      "./build/build-info.json"
    ],
    "permissions": {
      "read": true,
      "write": true,
      "env": {
        "allow": [
          "HOME",
          "XDG_CONFIG_HOME",
          "XDG_CACHE_HOME",
          "NO_COLOR",
          "HTTP_PROXY",
          "HTTPS_PROXY",
          "NO_PROXY",
          "NODE_DEBUG_NATIVE",
          "DENO_TRACE_PERMISSIONS",
          "NODE_DISABLE_COMPILE_CACHE",
          "NODE_COMPILE_CACHE_PORTABLE",
          "NODE_COMPILE_CACHE"
        ]
      },
      "sys": true,
      "net": false,
      "run": [
        "exiftool"
      ]
    }
  },
  "tasks": {
    "fmt": "deno fmt src test *.json",
    "lint": "deno lint",
    "check": "deno check *.json src test",
    "test": "deno test -A test/*.test.ts",
    "docs": "deno doc --json ./src/mod.ts > library-docs.json",
    "ok": "deno fmt && deno task lint && deno task check && deno task test && deno task docs"
  },
  "license": "MIT",
  "imports": {
    "@epdoc/cmd": "jsr:@epdoc/cmd@^0.3.3",
    "@epdoc/datetime": "jsr:@epdoc/datetime@^4.2.9",
    "@epdoc/fs": "jsr:@epdoc/fs@^1.6.10",
    "@epdoc/type": "jsr:@epdoc/type@^2.0.2",
    "@std/assert": "jsr:@std/assert@^1.0.19"
  }
}
