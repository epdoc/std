{
  "name": "@epdoc/exif",
  "version": "0.1.4",
  "description": "Read and write EXIF metadata via the exiftool binary",
  "exports": {
    ".": "./src/mod.ts"
  },
  "publish": {
    "include": [
      "src",
      "deno.json",
      "README.md",
      "library-metadata.json"
    ]
  },
  "tasks": {
    "fmt": "deno fmt src test *.json",
    "lint": "deno lint",
    "check": "deno check *.json src test",
    "test": "deno test -A test/*.test.ts",
    "docs": "deno doc --json ./src/mod.ts > library-docs.json",
    "ok": "deno fmt && deno task lint && deno task check && deno task test && deno task docs"
  },
  "license": "MIT",
  "imports": {
    "@epdoc/cmd": "jsr:@epdoc/cmd@^0.3.1",
    "@epdoc/datetime": "jsr:@epdoc/datetime@^4.2.7",
    "@epdoc/fs": "jsr:@epdoc/fs@^1.6.5",
    "@epdoc/type": "jsr:@epdoc/type@^2.0.2",
    "@std/assert": "jsr:@std/assert@^1.0.19"
  }
}
